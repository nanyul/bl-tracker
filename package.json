{
  "name": "bl-tracker",
  "version": "1.0.0",
  "description": "BL Tracker - Tu biblioteca personal de manhwas/mangas/webtoons BL",
  "main": "index.js",
  "scripts": {
    "dev": "cd app && npm run dev",
    "build": "cd app && npm run build",
    "api:dev": "cd api && php -S localhost:8000 -t public",
