# BL Tracker - Environment Variables

# App
APP_DEBUG=true
APP_URL=http://localhost/BL/api

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bl_tracker
DB_USER=root
DB_PASS=
# TiDB Cloud Serverless: DB_PORT=4000, DB_SSL=true
# DB_SSL_CA=C:/xampp/htdocs/BL/isrgrootx1.pem  (solo local Windows; en Docker usa el bundle del sistema)
DB_SSL=false
DB_SSL_CA=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRATION=604800

# MangaDex (optional - for chapter sync)
MANGADEX_USERNAME=your-mangadex-username
MANGADEX_PASSWORD=your-mangadex-password

# Frontend
VITE_API_URL=http://localhost/BL/api

# CORS prod (coma-separado): dominios de Render + Vercel
# CORS_ALLOWED_ORIGINS=https://bl-tracker-api.onrender.com,https://bl-tracker.vercel.app